<prefab version="1.6.0">
	<!--
	     The tool as the player holds it. RegisterTool in main.lua points here.

	     1. The name of the outer group must be instance= followed by this file's
	        own path. With any other path the tool loads but its placement is
	        lost, and it is drawn in the middle of the player's face.
	     2. Never write two hyphens in a row inside a comment in this file. XML
	        forbids it, the whole file then fails to parse, and the game reports
	        nothing.

	     eye_space holds where the tool sits on screen (fp_ = first person,
	     tp_ = third person). tool_space holds the model, the hand grip and the
	     muzzle, which main.lua reads with GetToolLocationWorldTransform("muzzle").

	     The model is the game's own pistol (data\vox\tool\gun.vox). To use your
	     own, save it as vox\{{ModId}}.vox in this mod and change file= to
	     MOD/vox/{{ModId}}.vox. One voxel is 0.1 m before scale is applied.
	-->
	<group name="instance=MOD/prefab/{{ModId}}.xml" pos="2.475 0.8 0.675" rot="0.0 0.0 0.0">
		<group name="eye_space">
			<location name="fp_action" tags="name=fp_action" pos="0.3 -0.45 -0.6" rot="2.5 2.5 2.5"/>
			<location name="tp_action" tags="name=tp_action" pos="0.35 -0.25 -0.475" rot="0.0 0.0 5.0"/>
			<location name="tp_action_crouch" tags="name=tp_action_crouch" pos="0.375 -0.4 -0.35" rot="0.0 -5.0 5.0"/>
			<location name="tp_run" template="-40 8 8" tags="name=tp_run" pos="0.3 -0.7 0.0" rot="-45.0 10.0 10.0"/>
			<location name="tp_jump" tags="name=tp_jump" pos="0.4 -0.55 -0.15" rot="-10.8 0.0 30"/>
			<location name="tp_crouch" tags="name=tp_crouch" pos="0.45 -0.6 0.0" rot="4 -9 21"/>
			<location name="tp_swim" tags="name=tp_swim" pos="0.45 -0.3 -0.3" rot="40.0 -40.0 40.0"/>
		</group>
		<group name="tool_space">
			<body dynamic="false">
				<vox texture="12 0.65" blendtexture="3 0.05" file="tool/gun.vox" scale="0.45"/>
			</body>
			<location name="tp_action_rh" tags="name=tp_action_rh ik_hand" pos="-0.015 0.045 -0.067" rot="0.0 90.0 0.0"/>
			<location name="muzzle" tags="name=muzzle" pos="-0.025 0.15 -0.475" rot="0.0 0.0 0.0"/>
		</group>
	</group>
</prefab>
