<configuration>
  <packageSources>
    <!-- BepInEx is published here, not on nuget.org. Without this feed the restore fails. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
