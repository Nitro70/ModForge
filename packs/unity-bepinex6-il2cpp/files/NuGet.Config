<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- BepInEx 6 is published here, not on nuget.org. Without this feed the restore fails. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <!-- Cpp2IL, which BepInEx.Unity.IL2CPP depends on, publishes its development builds here. -->
    <add key="Samboy" value="https://nuget.samboy.dev/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
