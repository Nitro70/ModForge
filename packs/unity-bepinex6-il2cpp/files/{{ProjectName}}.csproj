<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 6 runs IL2CPP plugins on its own bundled .NET 6 runtime, so this is net6.0 for every game. -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>{{ProjectName}}</AssemblyName>
    <RootNamespace>{{Namespace}}</RootNamespace>
    <Version>{{Version}}</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <!-- .NET 6 is out of support but it is what BepInEx ships; the interop dlls can disagree on versions. Both are harmless here. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NU1701;MSB3277</NoWarn>
{{#if GamePath}}

    <!-- The game this mod is for. Change this one line if the game moves. -->
    <GameDir>{{GamePath|xml}}</GameDir>
    <!-- BepInEx writes the game's classes here as normal .NET dlls the first time the game starts with it installed. -->
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
{{#else}}

    <!-- No game folder was set. Copy the dlls from <Game>\BepInEx\interop into lib\ (see lib\README.txt). -->
    <InteropDir>lib</InteropDir>
{{/if}}
  </PropertyGroup>

  <!-- Code that needs Unity or game classes sits inside #if HAS_INTEROP, so the project builds before the interop dlls exist. -->
  <PropertyGroup Condition="Exists('$(InteropDir)\UnityEngine.CoreModule.dll')">
    <DefineConstants>$(DefineConstants);HAS_INTEROP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- compile only: BepInEx is already in the game, so none of its dlls are copied to bin. -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="{{BepInExVersion}}" IncludeAssets="compile" />
  </ItemGroup>

  <!-- The game's classes and Unity, as generated by BepInEx. Private=false: they are not copied to bin. -->
  <ItemGroup>
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="WarnNoInterop" BeforeTargets="CoreCompile" Condition="!Exists('$(InteropDir)\UnityEngine.CoreModule.dll')">
{{#if GamePath}}
    <Warning Text="No interop assemblies in $(InteropDir). Install BepInEx 6 (IL2CPP build) in the game and start the game once, then build again. Until then the code inside #if HAS_INTEROP is left out." />
{{#else}}
    <Warning Text="No interop assemblies in lib\. Copy the dlls from the game's BepInEx\interop folder into lib\ and build again. Until then the code inside #if HAS_INTEROP is left out." />
{{/if}}
  </Target>
{{#if Deploy && GamePath}}

  <!-- After each build, copy the plugin into the game. Skipped when BepInEx is not installed there. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)" ContinueOnError="true" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(GameDir)\BepInEx\plugins\$(AssemblyName)" />
  </Target>
{{/if}}

</Project>
