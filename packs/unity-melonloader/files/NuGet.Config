<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The Unity reference assemblies (UnityEngine.Modules) and the Il2CppInterop builds that the MelonLoader
         package depends on are published here, not on nuget.org. Only used while the project compiles against
         NuGet packages, which is when MelonLoader is not installed in the game folder. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
