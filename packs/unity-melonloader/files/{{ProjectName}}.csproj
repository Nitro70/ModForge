<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
{{#if Backend == il2cpp}}
    <!-- MelonLoader (0.6 and newer) runs IL2CPP mods on .NET 6, so this is net6.0 for every IL2CPP game. -->
{{#else}}
    <!-- Mono game: netstandard2.1 for Unity 2021.2 and newer, net472 for Unity 2018.1 to 2021.1, net35 for older. -->
{{/if}}
    <TargetFramework>{{Tfm}}</TargetFramework>
    <AssemblyName>{{ProjectName}}</AssemblyName>
    <RootNamespace>{{Namespace}}</RootNamespace>
    <Version>{{Version}}</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <!-- MelonLoader, Unity and the game are built for other frameworks than this project; these warnings are expected and harmless. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);NU1701;NU1605;MSB3277</NoWarn>
{{#if GamePath}}

    <!-- The game this mod is for. Change this one line if the game moves. -->
    <GameDir>{{GamePath|xml}}</GameDir>
{{#if Backend == il2cpp}}
    <!-- MelonLoader's own dlls for IL2CPP games. -->
    <MelonLibDir>$(GameDir)\MelonLoader\net6</MelonLibDir>
    <!-- MelonLoader writes the game's classes here as normal .NET dlls the first time the game starts with it installed. -->
    <UnityDir>$(GameDir)\MelonLoader\Il2CppAssemblies</UnityDir>
{{#else}}
    <!-- MelonLoader's own dlls for Mono games. -->
    <MelonLibDir>$(GameDir)\MelonLoader\net35</MelonLibDir>
{{#if GameDataDir}}
    <ManagedDir>$(GameDir)\{{GameDataDir|xml}}\Managed</ManagedDir>
{{#else}}
    <ManagedDir>$(GameDir)\*_Data\Managed</ManagedDir>
{{/if}}
{{/if}}
{{#elif Backend == il2cpp}}

    <!-- No game folder was set. Copy the dlls from <Game>\MelonLoader\Il2CppAssemblies into lib\ (see lib\README.txt). -->
    <UnityDir>lib</UnityDir>
{{/if}}
  </PropertyGroup>
{{#if GamePath}}

  <PropertyGroup Condition="Exists('$(MelonLibDir)\MelonLoader.dll')">
    <MelonInstalled>true</MelonInstalled>
  </PropertyGroup>
{{/if}}
{{#if Backend == il2cpp}}

  <!-- Code that needs Unity or game classes sits inside #if HAS_UNITY, so the project builds before those dlls exist. -->
  <PropertyGroup Condition="Exists('$(UnityDir)\UnityEngine.CoreModule.dll')">
    <DefineConstants>$(DefineConstants);HAS_UNITY</DefineConstants>
  </PropertyGroup>
{{/if}}
{{#if GamePath}}

  <!-- MelonLoader and Harmony from the game folder: the exact version the game runs. -->
  <ItemGroup Condition="'$(MelonInstalled)' == 'true'">
    <Reference Include="$(MelonLibDir)\MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonLibDir)\0Harmony.dll" Private="false" />
{{#if Backend == il2cpp}}
    <Reference Include="$(MelonLibDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonLibDir)\Il2CppInterop.Common.dll" Private="false" Condition="Exists('$(MelonLibDir)\Il2CppInterop.Common.dll')" />
{{/if}}
  </ItemGroup>

  <!-- MelonLoader is not installed in the game yet: compile against the NuGet package instead. -->
  <ItemGroup Condition="'$(MelonInstalled)' != 'true'">
    <PackageReference Include="LavaGang.MelonLoader" Version="{{MelonVersion}}" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
{{#else}}

  <!-- No game folder was set, so MelonLoader and Harmony come from NuGet. compile only: nothing is copied to bin. -->
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="{{MelonVersion}}" IncludeAssets="compile" PrivateAssets="all" />
{{#if Backend == mono}}
    <PackageReference Include="UnityEngine.Modules" Version="{{UnityVersion}}" IncludeAssets="compile" PrivateAssets="all" />
{{/if}}
  </ItemGroup>
{{/if}}
{{#if Backend == mono}}

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
{{/if}}

{{#if Backend == il2cpp}}
  <!-- Unity and the game's classes, as generated by MelonLoader. Private=false: they are not copied to bin. -->
  <ItemGroup>
    <Reference Include="$(UnityDir)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="WarnNoUnity" BeforeTargets="CoreCompile" Condition="!Exists('$(UnityDir)\UnityEngine.CoreModule.dll')">
{{#if GamePath}}
    <Warning Text="No generated assemblies in $(UnityDir). Install MelonLoader in the game and start the game once, then build again. Until then the code inside #if HAS_UNITY is left out." />
{{#else}}
    <Warning Text="No generated assemblies in lib\. Copy the dlls from the game's MelonLoader\Il2CppAssemblies folder into lib\ and build again. Until then the code inside #if HAS_UNITY is left out." />
{{/if}}
  </Target>
{{#elif GamePath}}
  <!-- The game's own assemblies. Private=false: they are already in the game, so they are not copied to bin. -->
  <ItemGroup>
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp*.dll" Private="false" />
  </ItemGroup>
{{#else}}
  <!-- No game folder was set. Copy the game's Assembly-CSharp.dll (from <Game>_Data\Managed) into lib\ to use game classes. -->
  <ItemGroup>
    <Reference Include="lib\*.dll" Private="false" />
  </ItemGroup>
{{/if}}
{{#if Deploy && GamePath}}

  <!-- After each build, copy the mod into the game's Mods folder. Skipped when MelonLoader is not installed there. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\MelonLoader')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="true" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(GameDir)\Mods" />
  </Target>
{{/if}}

</Project>
