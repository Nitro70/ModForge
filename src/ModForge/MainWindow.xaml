<Window x:Class="ModForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModForge" Width="1500" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- One option row. The control inside depends on the option's kind. -->
        <DataTemplate x:Key="OptText">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" />
                <TextBox Style="{StaticResource Input}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OptFolder">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource Input}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontSize="12" />
                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Browse" Command="{Binding Browse}" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OptChoice">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Chip}" Content="{Binding Label}" GroupName="{Binding GroupName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OptBool">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OptionRow">
            <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource Vis}}" Margin="0,0,0,14">
                <TextBlock Text="{Binding GroupHeader}" Style="{StaticResource Caption}" Margin="0,8,0,10"
                           Visibility="{Binding HasGroupHeader, Converter={StaticResource Vis}}" />
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource OptText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="bool">
                                    <Setter Property="ContentTemplate" Value="{StaticResource OptBool}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="choice">
                                    <Setter Property="ContentTemplate" Value="{StaticResource OptChoice}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="folder">
                                    <Setter Property="ContentTemplate" Value="{StaticResource OptFolder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Help}" Foreground="{StaticResource Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasHelp, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="{}{ }" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="10.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ModForge" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="starter projects for game mods" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="12,1,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button Style="{StaticResource TitleButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="12,2,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Game -->
            <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                <DockPanel Margin="12,14,8,12">
                    <Grid DockPanel.Dock="Top" Margin="2,0,6,10">
                        <TextBlock Text="1   GAME" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding GamesNote}" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,4,10">
                        <TextBox x:Name="GameSearchBox" Style="{StaticResource Input}" Text="{Binding GameSearch, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,9,7" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Dim}" Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Search games" Foreground="{StaticResource Dim}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding GameSearch, Converter={StaticResource Vis}, ConverterParameter=empty}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Ghost}" Content="Add a game folder" Command="{Binding AddGame}" ToolTip="For a game that is not in a Steam or Epic library." />
                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Rescan" Command="{Binding Rescan}" />
                    </Grid>
                    <ListBox Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource RowItem}"
                             ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Opacity="{Binding Fade}" ToolTip="{Binding Tip}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{Binding Badge}">
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Tag}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 2. Template -->
            <Border Grid.Column="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                <DockPanel Margin="12,14,8,12">
                    <TextBlock DockPanel.Dock="Top" Text="2   TEMPLATE" Style="{StaticResource Caption}" Margin="2,0,0,10" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Engines}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}" Content="{Binding Label}" GroupName="EngineChips" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <ListBox Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource CardItem}"
                                 ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Background="#1F4CC38A" CornerRadius="9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasBadge, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Good}" FontSize="10.5" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No template fits this game and filter. Pick All, or Any game." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="4,10,10,0"
                                   Visibility="{Binding NoTemplates, Converter={StaticResource Vis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 3. Configure and preview -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="316" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Options -->
                    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                        <DockPanel Margin="14,14,6,8">
                            <TextBlock DockPanel.Dock="Top" Text="3   SET IT UP" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TemplateTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TemplateDescription}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,6,8,0" />
                            <Button DockPanel.Dock="Top" Style="{StaticResource Link}" Content="Loader documentation" Command="{Binding OpenDocs}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Visibility="{Binding HasDocs, Converter={StaticResource Vis}}" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Line}" Margin="0,12,8,12" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionRow}" Margin="0,0,10,0" Focusable="False" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Preview -->
                    <Border Grid.Column="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="14,14,8,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,6,10">
                                <TextBlock Text="WHAT YOU GET" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding FilesSummary}" Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MaxHeight="230" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ListBox MaxHeight="230" Style="{StaticResource CleanList}" ItemContainerStyle="{StaticResource FileItem}"
                                         ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding Path}" Background="Transparent">
                                                <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Muted}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Margin="0,0,6,0" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,7">
                                            <TextBlock Text="{Binding PreviewTitle}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 Foreground="#C9D1E4" FontFamily="{StaticResource Mono}" FontSize="12" Padding="10,8"
                                                 CaretBrush="{StaticResource Text}" SelectionBrush="{StaticResource Accent}"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AcceptsReturn="True">
                                            <TextBox.Resources>
                                                <!-- The square where the two scrollbars meet is drawn with this system brush. -->
                                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                                            </TextBox.Resources>
                                        </TextBox>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Create bar -->
                <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CREATE IN" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,9,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBox Style="{StaticResource Input}" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" FontSize="12" />
                            <TextBlock Foreground="{StaticResource Dim}" FontSize="11" Margin="2,4,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasProblem, Converter={StaticResource Vis}, ConverterParameter=not}">
                                <Run Text="makes  " /><Run Text="{Binding TargetHint, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Bad}" FontSize="11" Margin="2,4,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasProblem, Converter={StaticResource Vis}}" ToolTip="{Binding Problem}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Browse" Command="{Binding BrowseOutput}" Margin="8,0,0,0" VerticalAlignment="Top" />
                        <Button Grid.Column="3" Style="{StaticResource Ghost}" Content="Save as zip" Command="{Binding CreateZip}" IsEnabled="{Binding CanCreate}" Margin="18,0,0,0" VerticalAlignment="Top" />
                        <Button Grid.Column="4" Style="{StaticResource Primary}" Content="Create project" Command="{Binding CreateFolder}" IsEnabled="{Binding CanCreate}" Margin="8,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Margin="16,0,12,8">
            <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,260,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Dim}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource Link}" Command="{Binding ToggleSource}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Where templates come from, and how to update them.">
                <TextBlock Text="{Binding PackInfo}" Foreground="{StaticResource Dim}" FontSize="11.5" />
            </Button>
        </Grid>

        <!-- Template source panel -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="460" Margin="0,0,12,6"
                Background="#161A24" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="12" Padding="16,14"
                Visibility="{Binding ShowSource, Converter={StaticResource Vis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="TEMPLATES" Style="{StaticResource Caption}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="17" Margin="0,8,0,10"
                           Text="Templates are small text files composed on this PC. A set is built into the app. To get a newer set, paste the address of a pack zip (or a GitHub source zip that contains pack.json) and update." />
                <TextBox Style="{StaticResource Input}" Text="{Binding PackUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="12" />
                <Grid Margin="0,10,0,0">
                    <Button Style="{StaticResource Link}" Content="Open my own templates folder" Command="{Binding OpenUserPacks}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            ToolTip="Folders you put here are loaded next to the built-in templates. The format is in docs\PACK-FORMAT.md." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Ghost}" Content="Close" Command="{Binding ToggleSource}" />
                        <Button Style="{StaticResource Primary}" Content="Update" Command="{Binding UpdatePacks}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Done overlay -->
        <Grid Grid.RowSpan="3" Background="#B8080A0F" Visibility="{Binding ShowDone, Converter={StaticResource Vis}}">
            <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#161A24" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="14" Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#264CC38A">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Good}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding DoneTitle}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CreatedTarget}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="WHAT TO DO NEXT" Style="{StaticResource Caption}" Margin="0,20,0,8" />
                    <ItemsControl ItemsSource="{Binding NextSteps}" AlternationCount="100">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                               Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Vis}, ConverterParameter=number}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="18" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource Ghost}" Content="Close" Command="{Binding CloseDone}" />
                        <Button Style="{StaticResource Primary}" Content="Open folder" Command="{Binding OpenCreated}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
