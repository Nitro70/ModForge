<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ModForge</AssemblyName>
    <RootNamespace>ModForge</RootNamespace>
    <Version>0.1.0</Version>
    <Product>ModForge</Product>
    <Description>Starter projects for game mods</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>ModForge.Program</StartupObject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <PacksDir>$(MSBuildThisFileDirectory)..\..\packs</PacksDir>
    <PacksZip>$(MSBuildThisFileDirectory)obj\packs.zip</PacksZip>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- App.xaml is a plain page: Program.Main is the entry point so the same exe has a command-line mode. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- The template packs are zipped at build time and embedded, so the exe is the only file to ship. -->
  <ItemGroup>
    <PackSource Include="$(PacksDir)\**\*" />
  </ItemGroup>

  <Target Name="ZipPacks" BeforeTargets="EmbedPacks" Inputs="@(PackSource)" Outputs="$(PacksZip)">
    <MakeDir Directories="$(MSBuildThisFileDirectory)obj" />
    <Delete Files="$(PacksZip)" />
    <ZipDirectory SourceDirectory="$(PacksDir)" DestinationFile="$(PacksZip)" Overwrite="true" />
  </Target>

  <Target Name="EmbedPacks" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(PacksZip)" LogicalName="packs.zip" />
    </ItemGroup>
  </Target>

</Project>
